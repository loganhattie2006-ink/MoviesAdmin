@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<h1>Movies</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table align-middle">
    <thead>
        <tr>

            <th></th> @*Blank so the image displays first *@
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["TitleSort"]">
                    @Html.DisplayNameFor(model => model.Title)
                </a>
            </th>

            @* <th>
                @Html.DisplayNameFor(model => model.Description)
            </th> *@

            <th>
                @Html.DisplayNameFor(model => model.AgeRating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>

            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["RuntimeSort"]">
                    @Html.DisplayNameFor(model => model.Runtime)
                </a>
            </th>

            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["ReleasedSort"]">
                    @Html.DisplayNameFor(model => model.Released)
                </a>
            </th>

            @* <th>
                @Html.DisplayNameFor(model => model.ImageFileName)
            </th> *@

            <th>
                @Html.DisplayNameFor(model => model.Director)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageFileName))
                    {
                        <img src="~/images/movies/@item.ImageFileName"
                             alt="@item.Title" style="height:60px;" />
                    }
                </td>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.Description)
            </td> *@
            <td>
                @Html.DisplayFor(model => item.AgeRating)
            </td>
            <td>
                @Html.DisplayFor(model => item.Genre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Runtime)
            </td>
            <td>
                @Html.DisplayFor(model => item.Released)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.ImageFileName)
            </td> *@
            <td>
                @Html.DisplayFor(model => item.Director)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
